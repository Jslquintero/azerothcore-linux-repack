#
# Paladin Spell Block
#

# Enable spell blocking for paladins specialized in Holy or Protection.
PaladinSpellBlock.Enable = 1

# Require an equipped usable shield and the normal player block ability.
PaladinSpellBlock.RequireShield = 1

# Require the attacker to be in front of the paladin, matching normal block behavior.
PaladinSpellBlock.RequireFrontArc = 1

# Minimum active talent points in a tree for that tree to qualify.
PaladinSpellBlock.MinHolyPoints = 10
PaladinSpellBlock.MinProtectionPoints = 10

# If enabled, the dominant active talent tree is enough to qualify even below the minimum.
PaladinSpellBlock.AllowDominantTree = 0

# Use the player's real block chance as the base chance.
PaladinSpellBlock.UseRealBlockChance = 1

# Extra block chance by active tree.
PaladinSpellBlock.HolyBonusChance = 6.0
PaladinSpellBlock.ProtectionBonusChance = 10.0

# Maximum final spell block chance.
PaladinSpellBlock.MaxChance = 35.0

# Allow area spells to be blocked.
PaladinSpellBlock.AllowAreaSpells = 0

# Play the shield block/parry animation when a spell block succeeds.
PaladinSpellBlock.PlayAnimation = 0
